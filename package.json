{
  "name": "react-native-css-nitro",
  "version": "0.1.0",
  "description": "A",
  "main": "./lib/commonjs/index.js",
  "types": "./lib/typescript/module/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/module/src/index.d.ts",
      "default": "./lib/module/index.js",
      "import": "./lib/module/index.js"
    },
    "./components/*": {
      "source": "./src/components/*/index.ts",
      "types": "./lib/typescript/module/src/components/*/index.d.ts",
      "default": "./lib/module/components/*/index.js"
    },
    "./metro": {
      "source": "./src/metro/index.ts",
      "types": "./lib/typescript/module/src/metro/index.d.ts",
      "default": "./lib/module/metro/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "source": "./src/runtime.ts",
      "types": "./lib/typescript/module/src/runtime.d.ts",
      "default": "./lib/module/runtime.js"
    },
    "./native": {
      "source": "./src/native/index.ts",
      "types": "./lib/typescript/module/src/native/index.d.ts",
      "default": "./lib/module/native/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-css-nitro-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "build": "bob build",
    "nitrogen": "nitrogen",
    "test:native": "bash scripts/test-native.sh",
    "release": "release-it --only-version",
    "bench:cpp": "cmake -B cpp/tests/build -S cpp/tests -DCMAKE_BUILD_TYPE=Release && cmake --build cpp/tests/build --target css_bench && ./cpp/tests/build/css_bench",
    "bench:js": "jest --config bench/jest.bench.config.js --watchman=false",
    "bench": "yarn bench:cpp && yarn bench:js"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklawlor/react-native-css-nitro.git"
  },
  "author": "Mark Lawlor <mwlawlor@gmail.com> (https://github.com/marklawlor)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marklawlor/react-native-css-nitro/issues"
  },
  "homepage": "https://github.com/marklawlor/react-native-css-nitro#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@evilmartians/lefthook": "^1.12.3",
    "@expo/metro-config": "^54.0.7",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "^0.81.1",
    "@react-native/typescript-config": "^0.82.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/react-native": "^13.3.3",
    "@types/debug": "^4.1.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lightningcss": "1.30.1",
    "nitrogen": "^0.29.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-native": "0.82.0",
    "react-native-builder-bob": "^0.40.13",
    "react-native-nitro-modules": "^0.29.1",
    "react-native-reanimated": "^4.1.3",
    "react-native-worklets": "^0.6.1",
    "react-test-renderer": "19.1.0",
    "release-it": "^19.0.4",
    "tailwindcss": "^4.1.16",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.29.1",
    "react-native-reanimated": "^4.1.3",
    "react-native-worklets": "^0.6.1"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/jest/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-reanimated|react-native-worklets)/)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/src/__tests__/blocked/"
    ],
    "moduleNameMapper": {
      "^react-native-css/native-internal$": "/Users/dscanlon/nativewind-e2e/react-native-css/src/native-internal/index.ts",
      "^react-native-css/native/(.*)$": "/Users/dscanlon/nativewind-e2e/react-native-css/src/native/$1",
      "^react-native-css/(.*)$": "/Users/dscanlon/nativewind-e2e/react-native-css/src/$1"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-swift",
    "type": "nitro-module",
    "version": "0.54.3"
  },
  "dependencies": {
    "colorjs.io": "0.6.0-alpha.1",
    "comment-json": "^4.4.1",
    "debug": "^4.4.3"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
